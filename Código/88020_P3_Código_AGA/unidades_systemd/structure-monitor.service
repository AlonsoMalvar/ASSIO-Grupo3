[Unit]
Description=AURORA-6 monitor de la estructura (miembro A, mecánica)
After=network.target

[Service]
Type=simple
User=usuario_a
ExecStart=/opt/aurora6/tools/structure-monitor.sh
Restart=on-failure
RestartSec=3
# Endurecimiento (P3, apartado 5)
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
